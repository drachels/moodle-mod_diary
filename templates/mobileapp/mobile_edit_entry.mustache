{{!
    @template mod_diary/mobileapp/mobile_edit_entry

    Mobile edit entry view for the Diary plugin.

    Example context (json):
    {
        "cmid": 12,
        "name": "Diary",
        "canedit": true,
        "diaryid": 34,
        "format": 1,
        "title": ""
    }
}}

<div class="ion-padding">
    {{#warning}}
        <core-alert message="{{warning}}" type="warning"></core-alert>
    {{/warning}}

    <ion-card>
        <ion-card-header>
            <ion-card-title>{{name}}</ion-card-title>
        </ion-card-header>
        <ion-card-content>
            <h3 style="margin-top: 0;">{{#str}}startoredit, mod_diary{{/str}}</h3>
            {{#info}}<p><i>{{info}}</i></p>{{/info}}

            {{#hasmobilecontext}}
                {{#promptmode_summary}}<p><strong>{{promptmode_summary}}</strong></p>{{/promptmode_summary}}
                {{#promptcount_total}}<p>{{{promptcount_total}}}</p>{{/promptcount_total}}
                {{#promptcount_breakdown}}<p>{{{promptcount_breakdown}}}</p>{{/promptcount_breakdown}}

                {{#haspromptsummary}}
                    <div style="margin: 10px 0 15px;">
                        <h3 style="margin: 0 0 6px;">{{prompttitle}}</h3>
                        {{#promptdates}}<p><i>{{promptdates}}</i></p>{{/promptdates}}
                        <core-format-text text="{{promptbody}}" component="mod_diary" component-id="{{cmid}}"></core-format-text>
                    </div>
                {{/haspromptsummary}}

                {{#haslimitnotes}}
                    <div style="margin-bottom: 15px;">
                        {{#limitnotes}}<p>{{{html}}}</p>{{/limitnotes}}
                    </div>
                {{/haslimitnotes}}

                {{#hasmetricrequirements}}
                    <div style="margin-bottom: 15px;">
                        <h3 style="margin: 0 0 6px;">{{metricrequirementstitle}}</h3>
                        <ion-list>
                            {{#metricrequirements}}
                                <ion-item lines="none">
                                    <ion-label>{{text}}</ion-label>
                                </ion-item>
                            {{/metricrequirements}}
                        </ion-list>
                    </div>
                {{/hasmetricrequirements}}
            {{/hasmobilecontext}}

            {{^canedit}}
                <core-alert message="{{#str}}editingended, mod_diary{{/str}}" type="info"></core-alert>
            {{/canedit}}

            {{#canedit}}
                {{#haspromptselector}}
                    <div style="margin-bottom: 15px;">
                        <label style="display: block; color: #666; font-size: 12px; margin-bottom: 5px;">
                            {{promptselectorlabel}}
                        </label>
                        <select
                            (change)="CONTENT_OTHERDATA.promptid = +$event.target.value"
                            style="width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 4px; background: white; -webkit-appearance: none;">
                            {{#promptoptions}}
                                <option value="{{value}}" {{selected}}>{{label}}</option>
                            {{/promptoptions}}
                        </select>
                    </div>
                {{/haspromptselector}}

                <div style="margin-bottom: 15px;">
                    <label style="display: block; color: #666; font-size: 12px; margin-bottom: 5px;">
                        {{#str}}diarytitle, mod_diary{{/str}}
                    </label>
                    <input
                        type="text"
                        [(ngModel)]="CONTENT_OTHERDATA.title"
                        style="width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 4px; background: white; color: #111;">
                </div>

                <div style="margin-bottom: 15px;">
                    <core-rich-text-editor
                        [control]="textControl"
                        name="mod_diary_entry"
                        component="mod_diary"
                        [componentId]="CONTENT_OTHERDATA.cmid"
                        contextLevel="module"
                        [contextInstanceId]="CONTENT_OTHERDATA.cmid"
                        [draftExtraParams]="{itemid: CONTENT_OTHERDATA.itemid}"
                        placeholder="{{#str}}entry, mod_diary{{/str}}">
                    </core-rich-text-editor>
                </div>

                {{#attachmentshtml}}
                    <div style="margin-bottom: 15px;">
                        <core-format-text text="{{attachmentshtml}}" component="mod_diary" component-id="{{cmid}}"></core-format-text>
                    </div>
                {{/attachmentshtml}}

                {{#canattachments}}
                    <ion-accordion-group [value]="advanced ? 'advanced' : ''" (ionChange)="onAdvancedChanged($event)">
                        <ion-accordion value="advanced" toggleIconSlot="start">
                            <ion-item slot="header">
                                <ion-label>
                                    <h3 class="item-heading">{{#str}}advanced{{/str}}</h3>
                                </ion-label>
                            </ion-item>
                            <div slot="content">
                                <core-attachments
                                    [files]="attachmentsFiles"
                                    [maxSize]="CONTENT_OTHERDATA.maxbytes"
                                    [maxSubmissions]="CONTENT_OTHERDATA.maxattachments"
                                    [component]="'mod_diary'"
                                    [componentId]="CONTENT_OTHERDATA.cmid"
                                    [allowOffline]="true"
                                    [courseId]="CONTENT_OTHERDATA.courseid">
                                </core-attachments>
                            </div>
                        </ion-accordion>
                    </ion-accordion-group>
                {{/canattachments}}

                <div class="ion-margin-top">
                    <ion-button
                        expand="block"
                        [disabled]="isSaving"
                        (click)="saveDiaryEntry(false)">
                        {{#str}}savechanges{{/str}}
                    </ion-button>

                    <ion-button
                        expand="block"
                        fill="outline"
                        [disabled]="isSaving"
                        (click)="saveDiaryEntry(true)">
                        {{#str}}saveandcontinueediting, mod_diary{{/str}}
                    </ion-button>

                    <ion-button expand="block" fill="clear" onclick="history.back();">
                        {{#str}}cancel{{/str}}
                    </ion-button>
                </div>
            {{/canedit}}

            {{^canedit}}
                <div class="ion-margin-top">
                    <ion-button expand="block" fill="clear" onclick="history.back();">
                        {{#str}}back{{/str}}
                    </ion-button>
                </div>
            {{/canedit}}
        </ion-card-content>
    </ion-card>
</div>
